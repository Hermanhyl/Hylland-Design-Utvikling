---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Container from '@/components/Container.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';

const additionalWork = [
	{
		year: '2026',
		title: 'UX-revisjoner for markedsføringsbyrå',
		type: 'UX-audit (flere prosjekter)',
		client: 'Konfidensielt byråsamarbeid',
		href: null as string | null,
	},
	{
		year: '2025',
		title: 'Connecta.no',
		type: 'WordPress-utvikling',
		client: 'Connecta',
		href: 'https://connecta.no',
	},
	{
		year: '2025',
		title: 'GoneFishing',
		type: 'Progressiv webapplikasjon',
		client: 'Eget produkt',
		href: null as string | null,
	},
	{
		year: '2023',
		title: 'Illustrasjon og 3D-arbeid',
		type: 'Diverse',
		client: 'Egne prosjekter',
		href: 'https://portfolio-herman-hylland.netlify.app/',
	},
];

const caseStudies = [
	{
		title: 'MyHobbyist',
		client: 'Eget produkt',
		year: '2024–2025',
		role: 'Design & utvikling',
		problem:
			'Mange ønsker å utforske nye hobbyer, men vet ikke hvor de skal begynne — og generiske anbefalinger treffer sjelden riktig.',
		solution:
			'AI-drevet aktivitetskonsierge bygget som progressiv webapplikasjon, med personaliserte forslag og lavterskel inngang.',
		imageSrc: '/images/case-studies/hobbyist.jpg',
		imageAlt: 'MyHobbyist landingsside med hero-seksjon',
		liveHref: 'https://myhobbyist.app',
		liveLabel: 'myhobbyist.app',
	},
	{
		title: 'UX-revisjon for markedsføringsbyrå',
		client: 'Konfidensielt byråsamarbeid',
		year: '2026',
		role: 'UX-konsulent',
		problem:
			'Et markedsføringsbyrå trengte en uavhengig UX-gjennomgang av en av sine klienters nettsider, med fokus på brukerflyt, struktur og tilgjengelighet.',
		solution:
			'Heuristisk evaluering med 30 funn, prioriterte anbefalinger og en oppsummerende presentasjon — levert som 19-siders rapport.',
		imageSrc: '/photo-1667056624790-f0e8e391c086.avif',
		imageAlt: 'UX-revisjon — arbeidsflate med notater og analyse',
	},
	{
		title: 'BrannVRn',
		client: 'Sykehuspartner',
		year: '2023',
		role: 'Design & 3D',
		problem:
			'Tradisjonell brannvernopplæring er passiv og vanskelig å skalere på tvers av store organisasjoner med kritisk infrastruktur.',
		solution:
			'Immersiv VR-simulator som lar ansatte trene på realistiske scenarier — utviklet som bacheloroppgave, karakter A.',
		imageSrc: '/images/case-studies/brannvrn.png',
		imageAlt: '3D-miljø fra BrannVRn VR-simulatoren med brannslukker og rømningsplan',
		imageAspect: '4/3' as const,
	},
];
---

<BaseLayout
	title="Portefølje — Hylland Design & Utvikling"
	description="Et utvalg klientprosjekter, egne produkter og kreativt arbeid. Frontend-utvikling, UX-design og digital design fra Drammen."
>
	<!-- Hero -->
	<Section tone="default" padding="none" class="py-32 lg:py-40">
		<Eyebrow class="mb-6">Portefølje</Eyebrow>
		<h1 class="text-[length:var(--text-h1)] leading-[1.1] tracking-[-0.02em] text-balance">
			Et utvalg av arbeidet mitt.
		</h1>
		<p class="mt-8 max-w-[58ch] text-[length:var(--text-body)] leading-[1.6] text-text-muted">
			Klientprosjekter, egne produkter og prosjekter underveis i studiene.
			Vil du se det kreative arbeidet mitt — illustrasjon, 3D og case
			studies i lengre format — finner du det på den dedikerte
			porteføljesiden min.
		</p>
		<a
			href="https://portfolio-herman-hylland.netlify.app/"
			target="_blank"
			rel="noopener noreferrer"
			class="link-animated mt-8 inline-block text-[length:var(--text-body)] font-medium text-accent transition-colors"
		>
			Besøk hele porteføljen ↗
		</a>
	</Section>

	<!-- Featured case studies -->
	<Section tone="default" padding="default">
		<div class="mb-16">
			<Eyebrow>Utvalgte prosjekter</Eyebrow>
			<h2 class="mt-4 font-display text-3xl font-medium lg:text-4xl">
				Klientarbeid og egne produkter
			</h2>
		</div>
		<div class="space-y-24 lg:space-y-32">
			{caseStudies.map((c) => <CaseStudyCard {...c} />)}
		</div>
	</Section>

	<!-- Compact list of additional work -->
	<Section tone="warm" padding="default">
		<div class="mb-12">
			<Eyebrow>Mer arbeid</Eyebrow>
			<h2 class="mt-4 font-display text-3xl font-medium lg:text-4xl">
				Tidligere prosjekter
			</h2>
			<p class="mt-4 max-w-[55ch] text-[length:var(--text-body)] leading-[1.6] text-text-muted">
				Flere prosjekter — noen med dypere case studies på den dedikerte
				porteføljesiden.
			</p>
		</div>
		<ul class="divide-y divide-border border-b border-t border-border" role="list">
			{additionalWork.map((item) => (
				<li class="grid grid-cols-12 items-baseline gap-4 py-5">
					<span class="col-span-2 font-mono text-sm text-text-subtle">
						{item.year}
					</span>
					<div class="col-span-7 sm:col-span-6">
						<p class="font-display text-lg font-medium text-text">
							{item.title}
						</p>
						<p class="text-sm text-text-muted">
							{item.type} · {item.client}
						</p>
					</div>
					<div class="col-span-3 text-right sm:col-span-4">
						{item.href && (
							<a
								href={item.href}
								target="_blank"
								rel="noopener noreferrer"
								class="text-sm font-medium text-accent hover:underline"
							>
								Se ↗
							</a>
						)}
					</div>
				</li>
			))}
		</ul>
	</Section>

	<!-- Closing CTA -->
	<Section tone="deep" padding="default">
		<div class="max-w-[60ch]">
			<Eyebrow class="text-accent-soft">Hele porteføljen</Eyebrow>
			<p class="mt-4 font-display text-3xl font-medium text-text-on-deep lg:text-4xl">
				Vil du se det kreative arbeidet?
			</p>
			<p class="mt-6 text-[length:var(--text-body)] leading-[1.6] text-text-on-deep/60">
				Illustrasjon, 3D, animasjon og case studies i lengre format
				finner du på den dedikerte porteføljesiden min.
			</p>
			<a
				href="https://portfolio-herman-hylland.netlify.app/"
				target="_blank"
				rel="noopener noreferrer"
				class="mt-10 inline-block rounded-[2px] bg-accent px-6 py-3 font-medium text-bg transition-colors duration-150 hover:bg-accent-hover"
			>
				Besøk porteføljen ↗
			</a>
		</div>
	</Section>
</BaseLayout>
