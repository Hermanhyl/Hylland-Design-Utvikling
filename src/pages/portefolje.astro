---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
---

<BaseLayout
	title="Portefølje — Hylland Design og Utvikling"
	description="Utvalgte prosjekter og case-studier fra frontend-utvikling og UX/UI-design."
>
	<Container as="section" class="py-24 md:py-32 lg:py-40">
		<h1 class="text-balance">Portefølje</h1>
		<p class="mt-6 max-w-[55ch] text-[length:var(--text-body)] leading-[1.6] text-text-muted">
			Et utvalg prosjekter.
		</p>
	</Container>
</BaseLayout>
