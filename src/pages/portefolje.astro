---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import ConstellationBackground from '@/components/react/ConstellationBackground.tsx';
import CinemaCTA from '@/components/react/CinemaCTA.tsx';

const additionalWork = [
	{
		year: '2026',
		title: 'UX-revisjoner for markedsføringsbyrå',
		type: 'UX-audit (flere prosjekter)',
		client: 'Konfidensielt byråsamarbeid',
		href: null as string | null,
	},
	{
		year: '2025',
		title: 'GoneFishing',
		type: 'Progressiv webapplikasjon',
		client: 'Eget produkt',
		href: null as string | null,
	},
	{
		year: '2023',
		title: 'Illustrasjon og 3D-arbeid',
		type: 'Diverse',
		client: 'Egne prosjekter',
		href: 'https://portfolio-herman-hylland.netlify.app/',
	},
];

const caseStudies = [
	{
		title: 'Connecta',
		client: 'Connecta',
		year: '2025',
		role: 'Design & utvikling',
		category: 'Klientarbeid',
		windowLabel: 'connecta.no',
		summary:
			'Full redesign av en terapinettside: tydeligere struktur, innhold brutt ned i lesbare biter og et varmt, helhetlig uttrykk.',
		tags: ['Webdesign', 'WordPress', 'Redesign'],
		imageSrc: '/sections/1-forside-hero-ETTER.png',
		imageAlt: 'Connecta forside etter redesign: lys hero med tydelig overskrift og trygghetskort.',
		liveHref: 'https://connecta.no',
		liveLabel: 'connecta.no',
		caseHref: '/portefolje/connecta',
		caseLabel: 'Se case study',
	},
	{
		title: 'MyHobbyist',
		client: 'Eget produkt',
		year: '2024–2025',
		role: 'Design & utvikling',
		category: 'Eget produkt',
		windowLabel: 'myhobbyist.app',
		summary:
			'AI-drevet aktivitetskonsierge som hjelper folk å finne nye hobbyer og likesinnede. Bygget som progressiv webapp.',
		tags: ['Produktdesign', 'PWA', 'AI'],
		imageSrc: '/images/case-studies/hobbyist.jpg',
		imageAlt: 'MyHobbyist landingsside med hero-seksjon',
		liveHref: 'https://myhobbyist.app',
		liveLabel: 'myhobbyist.app',
	},
	{
		title: 'UX-revisjon for byrå',
		client: 'Konfidensielt byråsamarbeid',
		year: '2026',
		role: 'UX-konsulent',
		category: 'Klientarbeid',
		windowLabel: 'UX-rapport',
		summary:
			'Uavhengig heuristisk gjennomgang av en klients nettside: 30 funn, prioriterte anbefalinger og en 19-siders rapport.',
		tags: ['UX-audit', 'Heuristikk', 'Rapport'],
		imageSrc: '/photo-1667056624790-f0e8e391c086.avif',
		imageAlt: 'UX-revisjon — arbeidsflate med notater og analyse',
		imagePosition: 'center',
	},
	{
		title: 'BrannVRn',
		client: 'Sykehuspartner',
		year: '2023',
		role: 'Design & 3D',
		category: 'Bacheloroppgave',
		windowLabel: 'VR-simulator',
		summary:
			'Immersiv VR-simulator for brannvernopplæring der ansatte trener på realistiske scenarier. Bacheloroppgave, karakter A.',
		tags: ['3D-design', 'VR', 'Simulator'],
		imageSrc: '/images/case-studies/brannvrn.png',
		imageAlt: '3D-miljø fra BrannVRn VR-simulatoren med brannslukker og rømningsplan',
		imagePosition: 'center',
	},
];
---

<BaseLayout
	title="Portefølje | Hylland Design & Utvikling"
	description="Et utvalg klientprosjekter, egne produkter og kreativt arbeid. Frontend-utvikling, UX-design og digital design fra Drammen."
	darkHero
>
	<!-- Dark cinematic hero with the constellation background -->
	<div class="page-hero" data-hero>
		<ConstellationBackground client:load />
		<div class="page-hero-inner" data-reveal>
			<p class="hero-eyebrow">Portefølje</p>
			<h1 class="page-hero-title">Et utvalg av arbeidet mitt.</h1>
			<p class="hero-lede">
				Klientprosjekter, egne produkter og prosjekter underveis i studiene. Det kreative arbeidet
				mitt, illustrasjon, 3D og lengre case studies, finner du på den dedikerte porteføljesiden min.
			</p>
			<div class="hero-cta">
				<a href="/kontakt" class="hero-btn">Ta kontakt →</a>
				<a
					href="https://portfolio-herman-hylland.netlify.app/"
					target="_blank"
					rel="noopener noreferrer"
					class="hero-btn-ghost"
				>
					Besøk hele porteføljen ↗
				</a>
			</div>
		</div>
	</div>

	<!-- Featured case studies -->
	<Section tone="default" padding="default">
		<div class="mb-16">
			<Eyebrow>Utvalgte prosjekter</Eyebrow>
			<h2 class="mt-4 font-display text-3xl font-medium lg:text-4xl">
				Klientarbeid og egne produkter
			</h2>
		</div>
		<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
			{caseStudies.map((c) => <CaseStudyCard {...c} />)}
		</div>
	</Section>

	<!-- Compact list of additional work -->
	<Section tone="warm" padding="default">
		<div class="mb-12">
			<Eyebrow>Mer arbeid</Eyebrow>
			<h2 class="mt-4 font-display text-3xl font-medium lg:text-4xl">
				Tidligere prosjekter
			</h2>
			<p class="mt-4 max-w-[55ch] text-[length:var(--text-body)] leading-[1.6] text-text-muted">
				Flere prosjekter — noen med dypere case studies på den dedikerte
				porteføljesiden.
			</p>
		</div>
		<ul class="work-list divide-y divide-border" role="list" data-reveal>
			{additionalWork.map((item) => (
				<li class="work-row grid grid-cols-12 items-baseline gap-4 px-4 py-5">
					<span class="col-span-2 font-mono text-sm text-text-subtle">
						{item.year}
					</span>
					<div class="col-span-7 sm:col-span-6">
						<p class="work-title font-display text-lg font-medium text-text">
							{item.title}
						</p>
						<p class="text-sm text-text-muted">
							{item.type} · {item.client}
						</p>
					</div>
					<div class="col-span-3 text-right sm:col-span-4">
						{item.href && (
							<a
								href={item.href}
								target="_blank"
								rel="noopener noreferrer"
								class="text-sm font-medium text-accent hover:underline"
							>
								Se <span class="work-arrow">↗</span>
							</a>
						)}
					</div>
				</li>
			))}
		</ul>
	</Section>

	<!-- Dark cinematic finale (reused, portfolio copy) -->
	<CinemaCTA
		client:load
		eyebrow="Hele porteføljen"
		title="Vil du se det kreative arbeidet?"
		lede="Illustrasjon, 3D, animasjon og case studies i lengre format finner du på den dedikerte porteføljesiden min."
		primaryHref="https://portfolio-herman-hylland.netlify.app/"
		primaryLabel="Besøk porteføljen ↗"
		external
		secondaryHref="/kontakt"
		secondaryLabel="Ta kontakt →"
	/>
</BaseLayout>
