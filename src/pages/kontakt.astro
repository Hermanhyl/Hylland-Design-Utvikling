---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
	title="Kontakt — Herman Hylland"
	description="Ta kontakt for frontend-utvikling eller UX/UI-design. Basert i Drammen, tilgjengelig for oppdrag i hele Norge."
>
	<section class="mx-auto max-w-5xl px-6 py-32 md:px-8">
		<h1>La oss snakkes</h1>
		<p class="mt-4 max-w-2xl text-[length:var(--text-body)] leading-[1.6] text-text-muted">
			Send en e-post, eller fyll ut skjemaet.
		</p>
	</section>
</BaseLayout>
