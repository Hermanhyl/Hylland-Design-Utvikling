---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
---

<BaseLayout
	title="Tjenester — Hylland Design og Utvikling"
	description="Frontend-utvikling, UX/UI-design, og webrådgivning. Se hva jeg kan hjelpe deg med."
>
	<Container as="section" class="py-24 md:py-32 lg:py-40">
		<h1 class="text-balance">Tjenester</h1>
		<p class="mt-6 max-w-[55ch] text-[length:var(--text-body)] leading-[1.6] text-text-muted">
			Det jeg kan hjelpe deg med.
		</p>
	</Container>
</BaseLayout>
