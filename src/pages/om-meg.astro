---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
---

<BaseLayout
	title="Om meg — Herman Hylland"
	description="Lær mer om Herman Hylland — frontend-utvikler og UX/UI-designer basert i Drammen, Norge."
>
	<Container as="section" class="py-24 md:py-32 lg:py-40">
		<h1 class="text-balance">Om meg</h1>
		<p class="mt-6 max-w-[55ch] text-[length:var(--text-body)] leading-[1.6] text-text-muted">
			Bakgrunn, arbeidsmåte og hvorfor jeg gjør det jeg gjør.
		</p>
	</Container>
</BaseLayout>
