---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AuroraBackground from '@/components/react/AuroraBackground.tsx';

const email = 'hermanhyl@hotmail.com';

const socials = [
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/herman-hylland/' },
	{ label: 'GitHub', href: 'https://github.com/Hermanhyl' },
	{ label: 'Instagram', href: 'https://www.instagram.com/hermanhyl98/' },
];

const meta = [
	{ term: 'Sted', value: 'Drammen, Norge' },
	{ term: 'Svartid', value: 'Innen 24 t på hverdager' },
	{ term: 'Språk', value: 'Norsk · Engelsk' },
];
---

<BaseLayout
	title="Kontakt | Hylland Design & Utvikling"
	description="Ta kontakt med Hylland Design & Utvikling i Drammen. Send en uforpliktende melding om prosjektet ditt."
	darkHero
>
	<section class="contact-shell" data-hero>
		<AuroraBackground client:load />

		<div class="contact-inner">
			<div class="contact-head" data-reveal>
				<p class="hero-eyebrow">Kontakt</p>
				<h1 class="page-hero-title">La oss snakkes.</h1>
				<p class="hero-lede">
					Fortell meg noen ord om prosjektet du jobber med, så finner vi ut av det sammen. Ingen
					forpliktelser, bare en uforpliktende samtale.
				</p>
			</div>

			<div class="contact-grid">
				<!-- Left: direct contact + social + meta -->
				<aside data-reveal>
					<p class="contact-aside-label">Send direkte</p>
					<a href={`mailto:${email}`} class="contact-email">{email}</a>

					<div class="contact-social mt-10">
						<p class="contact-aside-label">Finn meg ellers</p>
						<div class="mt-4 space-y-3">
							{socials.map((s) => (
								<a
									href={s.href}
									target="_blank"
									rel="noopener noreferrer"
									class="group block text-[length:var(--text-body)] font-medium"
								>
									{s.label}
									<span class="inline-block transition-transform duration-200 group-hover:translate-x-1">↗</span>
								</a>
							))}
						</div>
					</div>

					<dl class="contact-meta mt-10 space-y-4 pt-8">
						{meta.map((m) => (
							<div>
								<dt class="font-mono text-xs uppercase tracking-[0.15em]">{m.term}</dt>
								<dd class="mt-1 text-[length:var(--text-body)]">{m.value}</dd>
							</div>
						))}
					</dl>
				</aside>

				<!-- Right: standout form card -->
				<div class="contact-card" data-reveal>
					<p class="text-xs font-medium uppercase tracking-[0.15em] text-accent">Skjema</p>
					<h2 class="mt-3 font-display text-2xl font-medium lg:text-3xl">Fyll ut og send</h2>
					<p class="mt-3 max-w-[42ch] text-[length:var(--text-body)] leading-[1.6] text-text-muted">
						Kort om hva du jobber med. Jeg svarer fra samme adresse, som regel innen et døgn.
					</p>

					<form
						name="kontakt"
						method="POST"
						action="/kontakt/takk"
						data-netlify="true"
						netlify-honeypot="bot-field"
						class="mt-8 space-y-5"
					>
						<input type="hidden" name="form-name" value="kontakt" />
						<p class="hidden">
							<label>Ikke fyll ut: <input name="bot-field" /></label>
						</p>

						<div class="contact-field">
							<label for="navn">Navn</label>
							<input type="text" id="navn" name="navn" required autocomplete="name" />
						</div>

						<div class="contact-field">
							<label for="epost">E-post</label>
							<input type="email" id="epost" name="epost" required autocomplete="email" />
						</div>

						<div class="contact-field">
							<label for="firma">Firma (valgfritt)</label>
							<input type="text" id="firma" name="firma" autocomplete="organization" />
						</div>

						<div class="contact-field">
							<label for="melding">Om prosjektet</label>
							<textarea id="melding" name="melding" rows="6" required></textarea>
						</div>

						<button type="submit" class="contact-submit">Send melding →</button>
					</form>
				</div>
			</div>
		</div>
	</section>

	<!-- Hidden form for Netlify build-time detection -->
	<form name="kontakt" data-netlify="true" netlify-honeypot="bot-field" hidden>
		<input type="text" name="navn" />
		<input type="email" name="epost" />
		<input type="text" name="firma" />
		<textarea name="melding"></textarea>
	</form>
</BaseLayout>
