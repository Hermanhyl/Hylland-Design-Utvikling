---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ScrollZoomHero from '@/components/react/ScrollZoomHero.tsx';
import PinnedScrollytelling from '@/components/react/PinnedScrollytelling.tsx';

const projects = [
	{
		title: 'MyHobbyist',
		client: 'Eget produkt',
		year: '2024–2025',
		type: 'Webapplikasjon',
		description:
			'AI-drevet aktivitetskonsierge bygget som progressiv webapplikasjon. Hjelper folk å oppdage og engasjere seg i nye hobbyer og aktiviteter.',
		contribution:
			'Designet og utviklet hele løsningen fra konsept til live produkt — React, TypeScript, Next.js og Supabase.',
		href: 'https://myhobbyist.app',
		linkLabel: 'myhobbyist.app',
	},
	{
		title: 'UX-revisjon for markedsføringsbyrå',
		client: 'Konfidensielt byråsamarbeid',
		year: '2026',
		type: 'UX-audit',
		description:
			'Uavhengig UX-gjennomgang av nettsiden til en byråklient, med fokus på brukerflyt, struktur og tilgjengelighet.',
		contribution:
			'Gjennomførte revisjonen og leverte en 19-siders rapport med 30 funn og prioriterte anbefalinger, samt en oppsummerende presentasjon.',
	},
	{
		title: 'BrannVRn',
		client: 'Sykehuspartner',
		year: '2023',
		type: 'VR-simulator',
		description:
			'Brannsikkerhetssimulator i virtuell virkelighet utviklet som bacheloroppgave i samarbeid med Sykehuspartner. Karakter A.',
		contribution:
			'Bidro til konseptutvikling, visuell design, 3D-miljø og brukeropplevelse i et tverrfaglig team.',
	},
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			name: 'Herman Hylland',
			jobTitle: 'Frontend-utvikler & UX/UI-designer',
			url: 'https://hermanhylland.no',
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Drammen',
				addressCountry: 'NO',
			},
		},
		{
			'@type': 'LocalBusiness',
			name: 'Hylland Design & Utvikling',
			url: 'https://hermanhylland.no',
			description: 'Frontend-utvikling og UX/UI-design i Drammen',
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Drammen',
				addressCountry: 'NO',
			},
		},
	],
};
---

<BaseLayout
	title="Hylland Design & Utvikling — Frontend-utvikler & UX/UI-designer"
	description="Frontend-utvikling og UX/UI-design fra Drammen. Jeg hjelper bedrifter med å bygge raske, tilgjengelige og brukervennlige nettsider."
	jsonLd={jsonLd}
>
	<!-- Hero: cinematic WebGL flagship.
	     The .hero-poster below is the server-rendered, SEO-/no-JS-friendly headline.
	     <ScrollZoomHero> is a client:only island (WebGL can't be SSR'd) that layers
	     the 3D scene + animated headline over it and hides the poster on hydrate
	     via [data-hydrated]. The shell reserves the runway height to avoid CLS. -->
	<div class="hero-shell" data-hero>
		<div class="hero-poster">
			<div class="hero-poster-inner">
				<p class="hero-eyebrow">Frilans · Drammen · 2026</p>
				<h1 class="hero-title">
					Frontend-utvikling og UX-design
					<span class="hero-title-accent italic"> fra Drammen.</span>
				</h1>
				<p class="hero-lede">
					Jeg hjelper bedrifter med å bygge nettløsninger som er raske, tydelige og lette å bruke.
				</p>
				<div class="hero-cta">
					<a href="/tjenester" class="link-animated">Se tjenester →</a>
					<span class="hero-cta-sep">·</span>
					<a href="/kontakt" class="link-animated">Ta kontakt →</a>
				</div>
			</div>
		</div>
		<ScrollZoomHero client:only="react" />
	</div>

	<!-- Prosess: pinned scrollytelling (client:visible island, SSR-stacked fallback) -->
	<PinnedScrollytelling client:visible />

	<!-- Utvalgte prosjekter -->
	<Section tone="default" padding="default">
		<Eyebrow>Portefølje</Eyebrow>
		<h2 class="mt-4 text-[length:var(--text-h2)] leading-[1.2]">Utvalgte prosjekter</h2>
		<p class="mt-4 text-[length:var(--text-body)] leading-[1.6] text-text-muted max-w-[55ch]">
			Et utvalg av arbeid fra de siste årene — egne produkter, klientarbeid og prosjekter underveis i studiene.
		</p>

		<div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
			{projects.map((p) => <ProjectCard {...p} />)}
		</div>

		<div class="mt-16">
			<a href="/portefolje" class="link-animated text-[length:var(--text-body)] font-medium text-text transition-colors duration-150 hover:text-accent">
				Se hele porteføljen →
			</a>
		</div>
	</Section>

	<!-- CTA -->
	<Section tone="deep" padding="default">
		<h2 class="font-display text-[length:var(--text-h2)] leading-[1.2]">Har du et prosjekt?</h2>
		<p class="mt-4 max-w-[50ch] text-[length:var(--text-body)] leading-[1.6] text-text-on-deep/70">
			Jeg er alltid interessert i nye samarbeid. Ta gjerne kontakt for en uforpliktende prat.
		</p>
		<a
			href="/kontakt"
			class="mt-8 inline-block bg-accent px-6 py-3 font-medium text-bg rounded-[2px] transition-colors hover:bg-accent-hover"
		>
			Ta kontakt
		</a>
	</Section>
</BaseLayout>
