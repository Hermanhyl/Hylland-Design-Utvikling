---
import BaseLayout from '@/layouts/BaseLayout.astro';

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			name: 'Herman Hylland',
			jobTitle: 'Frontend-utvikler & UX/UI-designer',
			url: 'https://hermanhylland.no',
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Drammen',
				addressCountry: 'NO',
			},
		},
		{
			'@type': 'LocalBusiness',
			name: 'Herman Hylland ENK',
			url: 'https://hermanhylland.no',
			description: 'Frontend-utvikling og UX/UI-design i Drammen',
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Drammen',
				addressCountry: 'NO',
			},
		},
	],
};
---

<BaseLayout
	title="Herman Hylland — Frontend-utvikler & UX/UI-designer"
	description="Frontend-utvikling og UX/UI-design fra Drammen. Jeg hjelper bedrifter med å bygge raske, tilgjengelige og brukervennlige nettsider."
	jsonLd={jsonLd}
>
	<section class="mx-auto max-w-5xl px-6 py-32 md:px-8">
		<h1 class="text-[length:var(--text-display)] leading-[1.05] tracking-[-0.02em]">
			Frontend-utvikling og UX-design fra&nbsp;Drammen.
		</h1>
		<p class="mt-6 max-w-2xl text-[length:var(--text-body)] leading-[1.6] text-text-muted">
			Jeg hjelper bedrifter med å bygge nettløsninger som er raske, tydelige og lette å bruke.
		</p>
	</section>
</BaseLayout>
