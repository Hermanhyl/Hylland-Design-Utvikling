---
import Container from '@/components/Container.astro';

const currentYear = new Date().getFullYear();

const navLinks = [
	{ href: '/tjenester', label: 'Tjenester' },
	{ href: '/portefolje', label: 'Portefølje' },
	{ href: '/om-meg', label: 'Om meg' },
	{ href: '/kontakt', label: 'Kontakt' },
];

const externalLinks = [
	{ href: 'mailto:hei@hermanhylland.no', label: 'E-post' },
	{ href: 'https://github.com/Hermanhyl', label: 'GitHub' },
	{ href: 'https://www.linkedin.com/in/herman-hylland/', label: 'LinkedIn' },
	{ href: 'https://www.instagram.com/hermanhyl98/', label: 'Instagram' },
];
---

<footer class="border-t border-text-on-deep/15 bg-bg-deep" transition:persist transition:name="site-footer">
	<Container size="wide" class="grid gap-8 py-12 md:grid-cols-3 md:gap-12 md:py-20">
		<!-- Left: Wordmark -->
		<div>
			<a
				href="/"
				class="font-display text-[1.25rem] font-[500] tracking-tight text-text-on-deep transition-colors hover:text-accent-soft"
			>
				Hylland Design & Utvikling
			</a>
			<p class="mt-2 text-[length:var(--text-small)] text-text-on-deep/60">
				Frontend, UX-design og rådgivning — Drammen
			</p>
		</div>

		<!-- Middle: Nav links -->
		<div>
			<p class="mb-4 text-[length:var(--text-micro)] font-medium uppercase tracking-wider text-text-on-deep/50">
				Sider
			</p>
			<ul class="flex flex-col gap-3" role="list">
				{navLinks.map(({ href, label }) => (
					<li>
						<a
							href={href}
							class="link-animated text-[length:var(--text-small)] text-text-on-deep transition-colors hover:text-accent-soft"
						>
							{label}
						</a>
					</li>
				))}
			</ul>
		</div>

		<!-- Right: External links -->
		<div>
			<p class="mb-4 text-[length:var(--text-micro)] font-medium uppercase tracking-wider text-text-on-deep/50">
				Kontakt & sosiale medier
			</p>
			<ul class="flex flex-col gap-3" role="list">
				{externalLinks.map(({ href, label }) => (
					<li>
						<a
							href={href}
							class="link-animated text-[length:var(--text-small)] text-text-on-deep transition-colors hover:text-accent-soft"
							{...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
						>
							{label}
							{href.startsWith('http') && (
								<span class="ml-1 inline-block text-[0.75em] opacity-50" aria-hidden="true">&#8599;</span>
							)}
						</a>
					</li>
				))}
			</ul>
		</div>

		<!-- Bottom row -->
		<div class="mt-16 border-t border-text-on-deep/15 pt-8 md:col-span-3">
			<div class="flex flex-col items-center gap-2 text-[length:var(--text-micro)] text-text-on-deep/50 md:flex-row md:justify-between">
				<p>&copy; {currentYear} Hylland Design & Utvikling</p>
				<p>Org.nr: XXX XXX XXX</p>
			</div>
		</div>
	</Container>
</footer>
