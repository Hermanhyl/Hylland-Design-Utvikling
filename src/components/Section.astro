---
import Container from '@/components/Container.astro';

interface Props {
	tone?: 'default' | 'warm' | 'deep';
	padding?: 'none' | 'tight' | 'default' | 'loose';
	id?: string;
	class?: string;
}

const {
	tone = 'default',
	padding = 'default',
	id,
	class: className,
} = Astro.props;

const toneClasses: Record<string, string> = {
	default: 'bg-bg',
	warm: 'bg-bg-warm',
	deep: 'bg-bg-deep text-text-on-deep',
};

const paddingClasses: Record<string, string> = {
	none: '',
	tight: 'py-16 md:py-20',
	default: 'py-24 md:py-32',
	loose: 'py-32 md:py-48',
};
---

<section id={id} class:list={[toneClasses[tone], paddingClasses[padding], className]} data-reveal>
	<Container>
		<slot />
	</Container>
</section>
