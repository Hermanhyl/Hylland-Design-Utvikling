---
interface Props {
	title: string;
	client?: string;
	year: string;
	role: string;
	/** Short one-to-two line blurb shown on the card. */
	summary: string;
	/** Role / tech chips. */
	tags?: string[];
	/** Small category pill over the image, e.g. "Eget produkt". */
	category?: string;
	/** Chrome-bar label: a domain for web projects, or a type otherwise. */
	windowLabel?: string;
	imageSrc?: string;
	imageAlt?: string;
	/** object-position for the framed shot. Screenshots look best top-anchored. */
	imagePosition?: string;
	/** External live link. */
	liveHref?: string;
	liveLabel?: string;
	/** Internal case-study page link (same tab). */
	caseHref?: string;
	caseLabel?: string;
}

const {
	title,
	client,
	year,
	role,
	summary,
	tags = [],
	category,
	windowLabel,
	imageSrc,
	imageAlt,
	imagePosition = 'top center',
	liveHref,
	liveLabel,
	caseHref,
	caseLabel,
} = Astro.props;

// Whole-card click target: the case study if there is one, otherwise the live
// site. Rendered as a "stretched link" so the entire card is clickable while
// the secondary link stays independently clickable.
const hasLink = Boolean(caseHref || liveHref);
---

<article class:list={['pcard group', { 'pcard--link': hasLink }]} data-reveal>
	<div class="pcard-media">
		<div class="pcard-chrome" aria-hidden="true">
			<span class="pcard-dots"><i></i><i></i><i></i></span>
			{windowLabel && <span class="pcard-url">{windowLabel}</span>}
		</div>
		<div class="pcard-shot">
			{imageSrc ? (
				<img
					src={imageSrc}
					alt={imageAlt ?? ''}
					style={`object-position: ${imagePosition}`}
					loading="lazy"
					decoding="async"
				/>
			) : (
				<span class="pcard-noimg">Bilde kommer</span>
			)}
			{category && <span class="pcard-cat">{category}</span>}
		</div>
	</div>

	<div class="pcard-body">
		<p class="pcard-meta">{role} · {year}{client ? ` · ${client}` : ''}</p>
		<h3 class="pcard-title">{title}</h3>
		<p class="pcard-summary">{summary}</p>

		{tags.length > 0 && (
			<ul class="pcard-tags" role="list">
				{tags.map((t) => <li>{t}</li>)}
			</ul>
		)}

		{(caseHref || liveHref) && (
			<div class="pcard-foot">
				{caseHref && (
					<a href={caseHref} class="pcard-link pcard-link--primary pcard-stretch">
						{caseLabel ?? 'Se case study'} <span class="pcard-arrow">→</span>
					</a>
				)}
				{liveHref && (
					<a href={liveHref} target="_blank" rel="noopener noreferrer" class:list={['pcard-link', caseHref ? 'pcard-link--raised' : 'pcard-stretch']}>
						{liveLabel ?? 'Besøk'} <span class="pcard-arrow">↗</span>
					</a>
				)}
			</div>
		)}
	</div>
</article>
