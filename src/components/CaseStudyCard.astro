---
interface Props {
	title: string;
	client: string;
	year: string;
	role: string;
	problem: string;
	solution: string;
	imageAspect?: '16/10' | '4/3';
	imageSrc?: string;
	imageAlt?: string;
	liveHref?: string;
	liveLabel?: string;
	caseStudyHref?: string;
	/** Internal case-study page link (same tab). */
	caseHref?: string;
	caseLabel?: string;
	index?: number;
	reverse?: boolean;
}

const {
	title,
	client,
	year,
	role,
	problem,
	solution,
	imageAspect = '16/10',
	imageSrc,
	imageAlt,
	liveHref,
	liveLabel,
	caseStudyHref,
	caseHref,
	caseLabel,
	index,
	reverse = false,
} = Astro.props;

const num = index != null ? String(index).padStart(2, '0') : null;
---

<article class="group grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12 cursor-default transition-transform duration-300 ease-out hover:-translate-y-1" data-reveal>
	<!-- Image column -->
	<div class:list={['lg:col-span-7', reverse && 'lg:order-2']}>
		<div
			class="cs-image relative w-full overflow-hidden border border-border bg-bg-warm"
			style={`aspect-ratio: ${imageAspect}`}
			data-reveal="zoom"
		>
			{imageSrc ? (
				<div class="cs-image-inner absolute inset-x-0" style="top: -9%; height: 118%" data-parallax data-parallax-speed="0.05">
					<img
						src={imageSrc}
						alt={imageAlt ?? ''}
						class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
						loading="lazy"
					/>
				</div>
			) : (
				<div class="absolute inset-0 flex items-center justify-center">
					<p class="text-xs uppercase tracking-[0.15em] text-text-subtle">
						Bilde kommer
					</p>
				</div>
			)}
		</div>
	</div>

	<!-- Text column -->
	<div class:list={['relative isolate flex flex-col justify-center lg:col-span-5', reverse && 'lg:order-1']}>
		{num && <span class="cs-num" aria-hidden="true">{num}</span>}
		<p class="font-mono text-xs font-medium uppercase tracking-[0.15em] text-text-subtle">
			{role} · {year}
		</p>
		<h3 class="mt-3 font-display text-3xl font-medium text-text">
			{title}
		</h3>
		<p class="mt-1 text-sm italic text-text-muted">
			for {client}
		</p>

		<div class="mt-6 space-y-4">
			<div>
				<p class="text-xs font-medium uppercase tracking-[0.15em] text-accent">Utfordring</p>
				<p class="mt-2 max-w-[45ch] text-[length:var(--text-body)] leading-[1.6] text-text-muted">
					{problem}
				</p>
			</div>
			<div>
				<p class="text-xs font-medium uppercase tracking-[0.15em] text-accent">Løsning</p>
				<p class="mt-2 max-w-[45ch] text-[length:var(--text-body)] leading-[1.6] text-text-muted">
					{solution}
				</p>
			</div>
		</div>

		{(liveHref || caseStudyHref || caseHref) && (
			<div class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
				{caseHref && (
					<a
						href={caseHref}
						class="link-animated inline-flex items-center gap-1 text-sm font-medium text-accent"
					>
						{caseLabel ?? 'Se case study'} <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
					</a>
				)}
				{liveHref && (
					<a
						href={liveHref}
						target="_blank"
						rel="noopener noreferrer"
						class="link-animated inline-flex items-center gap-1 text-sm font-medium text-accent"
					>
						{liveLabel ?? 'Besøk siden'} <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">↗</span>
					</a>
				)}
				{caseStudyHref && (
					<a
						href={caseStudyHref}
						target="_blank"
						rel="noopener noreferrer"
						class="link-animated inline-flex items-center gap-1 text-sm font-medium text-text transition-colors hover:text-accent"
					>
						Les case study <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">↗</span>
					</a>
				)}
			</div>
		)}
	</div>
</article>
