---
interface Props {
	title: string;
	client: string;
	year: string;
	role: string;
	problem: string;
	solution: string;
	imageAspect?: '16/10' | '4/3';
	imageSrc?: string;
	imageAlt?: string;
	liveHref?: string;
	liveLabel?: string;
	caseStudyHref?: string;
}

const {
	title,
	client,
	year,
	role,
	problem,
	solution,
	imageAspect = '16/10',
	imageSrc,
	imageAlt,
	liveHref,
	liveLabel,
	caseStudyHref,
} = Astro.props;
---

<article class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
	<!-- Image column -->
	<div class="lg:col-span-7">
		<div
			class="relative w-full overflow-hidden border border-border bg-bg-warm"
			style={`aspect-ratio: ${imageAspect}`}
		>
			{imageSrc ? (
				<img
					src={imageSrc}
					alt={imageAlt ?? ''}
					class="h-full w-full object-cover"
					loading="lazy"
				/>
			) : (
				<div class="absolute inset-0 flex items-center justify-center">
					<p class="text-xs uppercase tracking-[0.15em] text-text-subtle">
						Bilde kommer
					</p>
				</div>
			)}
		</div>
	</div>

	<!-- Text column -->
	<div class="flex flex-col justify-center lg:col-span-5">
		<p class="font-mono text-xs font-medium uppercase tracking-[0.15em] text-text-subtle">
			{role} · {year}
		</p>
		<h3 class="mt-3 font-display text-3xl font-medium text-text">
			{title}
		</h3>
		<p class="mt-1 text-sm italic text-text-muted">
			for {client}
		</p>

		<div class="mt-6 space-y-4">
			<div>
				<p class="text-xs font-medium uppercase tracking-[0.15em] text-accent">Utfordring</p>
				<p class="mt-2 max-w-[45ch] text-[length:var(--text-body)] leading-[1.6] text-text-muted">
					{problem}
				</p>
			</div>
			<div>
				<p class="text-xs font-medium uppercase tracking-[0.15em] text-accent">Løsning</p>
				<p class="mt-2 max-w-[45ch] text-[length:var(--text-body)] leading-[1.6] text-text-muted">
					{solution}
				</p>
			</div>
		</div>

		{(liveHref || caseStudyHref) && (
			<div class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
				{liveHref && (
					<a
						href={liveHref}
						target="_blank"
						rel="noopener noreferrer"
						class="text-sm font-medium text-accent hover:underline"
					>
						{liveLabel ?? 'Besøk siden'} ↗
					</a>
				)}
				{caseStudyHref && (
					<a
						href={caseStudyHref}
						target="_blank"
						rel="noopener noreferrer"
						class="text-sm font-medium text-text transition-colors hover:text-accent"
					>
						Les case study ↗
					</a>
				)}
			</div>
		)}
	</div>
</article>
