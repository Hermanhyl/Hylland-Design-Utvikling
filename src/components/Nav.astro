---
import Container from '@/components/Container.astro';

const pathname = Astro.url.pathname;

const links = [
	{ href: '/tjenester', label: 'Tjenester' },
	{ href: '/portefolje', label: 'Portefølje' },
	{ href: '/om-meg', label: 'Om meg' },
	{ href: '/kontakt', label: 'Kontakt' },
];

function isActive(href: string): boolean {
	return pathname === href || pathname === `${href}/`;
}
---

<header
	class="site-header"
	data-scrolled="false"
	transition:persist
	transition:name="site-nav"
>
	<nav aria-label="Hovedmeny">
		<Container size="wide" class="flex h-[var(--nav-height)] items-center justify-between">
			<!-- Logo -->
			<a
				href="/"
				class="font-display text-lg font-medium text-text transition-colors duration-150 hover:text-accent"
				aria-current={pathname === '/' || pathname === '' ? 'page' : undefined}
			>
				Herman Hylland
			</a>

			<!-- Desktop nav -->
			<ul class="hidden items-center gap-1 md:flex" role="list">
				{links.map(({ href, label }) => (
					<li>
						<a
							href={href}
							class="nav-link relative block px-3 py-2 text-sm font-medium tracking-[0.01em] text-text transition-colors duration-150 hover:text-accent"
							aria-current={isActive(href) ? 'page' : undefined}
						>
							{label}
						</a>
					</li>
				))}
			</ul>

			<!-- Mobile toggle -->
			<button
				type="button"
				class="mobile-toggle relative z-[60] flex h-10 w-10 items-center justify-center md:hidden"
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="Åpne meny"
			>
				<span class="hamburger" aria-hidden="true">
					<span></span>
					<span></span>
				</span>
			</button>
		</Container>
	</nav>

	<!-- Mobile overlay -->
	<div
		id="mobile-menu"
		class="mobile-overlay"
		data-mobile-menu
		role="dialog"
		aria-modal="true"
		aria-label="Navigasjonsmeny"
		hidden
	>
		<Container as="nav" class="flex h-full flex-col justify-center gap-2" aria-label="Mobilmeny">
			{links.map(({ href, label }) => (
				<a
					href={href}
					data-mobile-menu-link
					class:list={[
						'mobile-nav-link block py-4 font-display text-3xl transition-all duration-150 ease-out hover:text-accent active:scale-[0.97] active:text-accent will-change-transform',
						{ 'text-accent': isActive(href) },
						{ 'text-text': !isActive(href) },
					]}
					aria-current={isActive(href) ? 'page' : undefined}
				>
					{label}
				</a>
			))}
		</Container>
	</div>
</header>

<style>
	/* ─── Header ─── */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		transition: background-color 0.2s ease, border-color 0.2s ease;
		border-bottom: 1px solid transparent;
	}

	.site-header[data-scrolled='true'] {
		background-color: oklch(from var(--color-bg) l c h / 0.8);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom-color: var(--color-border);
	}

	/* ─── Desktop link active dot ─── */
	.nav-link[aria-current='page']::after {
		content: '';
		position: absolute;
		bottom: 2px;
		left: 50%;
		transform: translateX(-50%);
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background-color: var(--color-accent);
	}

	/* ─── Hamburger icon (2-line) ─── */
	.hamburger {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 6px;
		width: 22px;
		height: 22px;
	}

	.hamburger span {
		display: block;
		width: 100%;
		height: 2px;
		background-color: var(--color-text);
		border-radius: 1px;
		transition: transform 0.25s ease, opacity 0.25s ease;
		transform-origin: center;
	}

	.mobile-toggle[aria-expanded='true'] .hamburger span:nth-child(1) {
		transform: translateY(4px) rotate(45deg);
	}

	.mobile-toggle[aria-expanded='true'] .hamburger span:nth-child(2) {
		transform: translateY(-4px) rotate(-45deg);
	}

	/* ─── Mobile overlay ─── */
	.mobile-overlay {
		position: fixed;
		inset: 0;
		z-index: 50;
		background-color: var(--color-bg);
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.2s ease, visibility 0.2s ease;
	}

	.mobile-overlay[hidden] {
		display: block;
		opacity: 0;
		visibility: hidden;
	}

	.mobile-overlay.is-open {
		opacity: 1;
		visibility: visible;
	}

	.mobile-nav-link {
		opacity: 0;
		transform: translateY(8px);
		transition: opacity 0.2s ease, transform 0.2s ease, color 0.15s ease;
	}

	.mobile-overlay.is-open .mobile-nav-link {
		opacity: 1;
		transform: translateY(0);
	}

	.mobile-overlay.is-open .mobile-nav-link:nth-child(1) { transition-delay: 0.04s; }
	.mobile-overlay.is-open .mobile-nav-link:nth-child(2) { transition-delay: 0.08s; }
	.mobile-overlay.is-open .mobile-nav-link:nth-child(3) { transition-delay: 0.12s; }
	.mobile-overlay.is-open .mobile-nav-link:nth-child(4) { transition-delay: 0.16s; }
</style>

<script>
	import { navigate } from 'astro:transitions/client';

	// Module-level state shared across navigations
	let isOpen = false;

	function initNav() {
		const header = document.querySelector('.site-header') as HTMLElement | null;
		const toggle = document.querySelector('.mobile-toggle') as HTMLButtonElement | null;
		const overlay = document.getElementById('mobile-menu');
		if (!header || !toggle || !overlay) return;

		// ── Every navigation: update active links ──
		const path = window.location.pathname;

		const logo = header.querySelector('a[href="/"]');
		if (logo) {
			if (path === '/' || path === '') {
				logo.setAttribute('aria-current', 'page');
			} else {
				logo.removeAttribute('aria-current');
			}
		}

		header.querySelectorAll('.nav-link, .mobile-nav-link').forEach((link) => {
			const href = link.getAttribute('href');
			if (!href) return;
			const active = path === href || path === `${href}/`;

			if (active) {
				link.setAttribute('aria-current', 'page');
			} else {
				link.removeAttribute('aria-current');
			}

			if (link.classList.contains('mobile-nav-link')) {
				link.classList.toggle('text-accent', active);
				link.classList.toggle('text-text', !active);
			}
		});

		// ── Every navigation: reset scroll state ──
		header.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';

		// ── Every navigation: force-close menu if open ──
		if (isOpen) {
			isOpen = false;
			overlay.classList.remove('is-open');
			overlay.hidden = true;
			toggle.setAttribute('aria-expanded', 'false');
			toggle.setAttribute('aria-label', 'Åpne meny');
			document.body.style.overflow = '';
		}

		// ── Once: attach event listeners (persisted element, never re-added) ──
		if (header.dataset.navInit) return;
		header.dataset.navInit = 'true';

		// Scroll detection
		function onScroll() {
			header!.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';
		}
		window.addEventListener('scroll', onScroll, { passive: true });

		// Mobile menu open/close
		function openMenu() {
			isOpen = true;
			overlay!.hidden = false;
			void overlay!.offsetHeight;
			overlay!.classList.add('is-open');
			toggle!.setAttribute('aria-expanded', 'true');
			toggle!.setAttribute('aria-label', 'Lukk meny');
			document.body.style.overflow = 'hidden';
			const firstLink = overlay!.querySelector('a') as HTMLElement | null;
			firstLink?.focus();
		}

		function closeMenu() {
			isOpen = false;
			overlay!.classList.remove('is-open');
			toggle!.setAttribute('aria-expanded', 'false');
			toggle!.setAttribute('aria-label', 'Åpne meny');
			document.body.style.overflow = '';
			toggle!.focus();
			setTimeout(() => {
				if (!isOpen) overlay!.hidden = true;
			}, 200);
		}

		toggle.addEventListener('click', () => {
			isOpen ? closeMenu() : openMenu();
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && isOpen) closeMenu();
		});

		// Focus trap
		overlay.addEventListener('keydown', (e) => {
			if (e.key !== 'Tab' || !isOpen) return;

			const focusable = overlay!.querySelectorAll<HTMLElement>(
				'a[href], button, [tabindex]:not([tabindex="-1"])'
			);
			if (focusable.length === 0) return;

			const first = focusable[0];
			const last = focusable[focusable.length - 1];

			if (e.shiftKey && document.activeElement === first) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		});

		// Close menu on link click
		overlay.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => closeMenu());
		});

		// Tap feedback on mobile menu links
		attachTapFeedback();
	}

	function attachTapFeedback() {
		const links = document.querySelectorAll('[data-mobile-menu-link]');
		links.forEach((link) => {
			if ((link as HTMLElement).dataset.tapAttached === 'true') return;
			(link as HTMLElement).dataset.tapAttached = 'true';

			link.addEventListener('click', (e) => {
				const href = link.getAttribute('href');
				if (!href) return;
				if (href.startsWith('http') || href.startsWith('mailto:')) return;

				const reduced = window.matchMedia(
					'(prefers-reduced-motion: reduce)'
				).matches;
				if (reduced) return;

				e.preventDefault();
				link.classList.add('is-tapped');

				setTimeout(() => {
					const menu = document.querySelector('[data-mobile-menu]');
					if (menu) (menu as HTMLElement).dataset.open = 'false';
					document.body.style.overflow = '';
					link.classList.remove('is-tapped');
					try {
						navigate(href);
					} catch {
						window.location.href = href;
					}
				}, 180);
			});
		});
	}

	document.addEventListener('astro:page-load', initNav);
</script>
