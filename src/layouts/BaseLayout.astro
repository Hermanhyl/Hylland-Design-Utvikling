---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import LoadingOverlay from '@/components/LoadingOverlay.astro';

interface Props {
	title: string;
	description: string;
	ogImage?: string;
	canonicalUrl?: string;
	jsonLd?: Record<string, unknown>;
	/** Set on pages with a dark cinematic hero so the nav starts transparent/light. */
	darkHero?: boolean;
	/** Keep the page out of search indexes (utility pages, thank-you, styleguide). */
	noindex?: boolean;
}

const {
	title,
	description,
	ogImage = '/og-default.png',
	canonicalUrl,
	jsonLd,
	darkHero = false,
	noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.origin ?? 'https://hermanhylland.no';
const canonical = canonicalUrl ?? Astro.url.href;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="no">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#FAFAF7" />

		<!-- SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={fullOgImage} />
		<meta property="og:locale" content="nb_NO" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={fullOgImage} />

		<!-- Sitemap -->
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Favicon + icons -->
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<!-- JSON-LD structured data -->
		{jsonLd && (
			<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		)}

		<ClientRouter />
	</head>

	<body class="grain flex min-h-svh flex-col">
		<LoadingOverlay />
		<Nav overHero={darkHero} />

		<main id="main" class="flex-1" style={`min-height: calc(100vh - var(--nav-height));`}>
			<slot />
		</main>

		<Footer />

		<script>
			import '@/scripts/scroll-reveal';
			import '@/scripts/counter';
			import '@/scripts/service-motion';
			import '@/scripts/parallax';
			import '@/scripts/tilt';
			import '@/scripts/timeline';
		</script>
	</body>
</html>
