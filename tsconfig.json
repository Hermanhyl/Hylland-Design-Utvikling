{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@/components/*": ["src/components/*"],
			"@/layouts/*": ["src/layouts/*"],
			"@/content/*": ["src/content/*"],
			"@/styles/*": ["src/styles/*"]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	}
}
